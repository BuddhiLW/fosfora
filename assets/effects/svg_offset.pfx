{
  "name": "SVG Offset",
  "description": "Concentric outlines crawl through any SVG. Load vector artwork from the SVG Offset panel; use continuous or bouncing motion and original or animated palettes.",
  "author": "Fosfora",
  "category": "pattern",
  "tags": ["svg", "vector", "contours", "rings"],
  "svg_offset": {},
  "passes": [{"name": "svg", "shader": "svg_offset_bg.wgsl", "inputs": ["@svg.sdf"]}],
  "inputs": [
    {"name":"amount", "label":"Amount", "type":"Float", "default":12.0, "min":1.0, "max":80.0},
    {"name":"weight", "label":"Weight", "type":"Float", "default":0.32, "min":0.01, "max":1.0},
    {"name":"shrink", "label":"Shrink", "type":"Float", "default":1.0, "min":0.0, "max":2.0},
    {"name":"speed", "label":"Speed", "type":"Float", "default":0.15, "min":-2.0, "max":2.0},
    {"name":"phase", "label":"Phase", "type":"Float", "default":0.0, "min":0.0, "max":1.0},
    {"name":"mode", "label":"Continuous / Bounce", "type":"Int", "default":0, "min":0, "max":1},
    {"name":"color_mode", "label":"Color mode (Grey / Rainbow / White / Original)", "type":"Int", "default":1, "min":0, "max":3},
    {"name":"order", "label":"Order (Radial / Vertical / Group / Random)", "type":"Int", "default":0, "min":0, "max":3},
    {"name":"falloff", "label":"Falloff", "type":"Float", "default":0.35, "min":0.0, "max":4.0},
    {"name":"boost", "label":"Boost", "type":"Float", "default":1.0, "min":0.0, "max":4.0},
    {"name":"hue_speed", "label":"Hue speed", "type":"Float", "default":0.035, "min":-1.0, "max":1.0},
    {"name":"hue_phase", "label":"Hue phase", "type":"Float", "default":0.0, "min":0.0, "max":1.0},
    {"name":"scale", "label":"Scale", "type":"Float", "default":1.0, "min":0.1, "max":4.0}
  ],
  "rates": ["speed", "hue_speed"]
}
